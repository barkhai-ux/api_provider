{
  "openapi": "3.1.0",
  "info": {
    "title": "Ubhub Location Service API",
    "description": "\nGeocoding, reverse geocoding and routing for Mongolia.\n\n**Authentication.** Every `/v1` request needs an API key in the `Authorization` header:\n`Authorization: Bearer YOUR_API_KEY`. Create keys in the developer console.\n\n**Errors.** Every error uses one envelope:\n`{\"error\": {\"code\": \"INVALID_REQUEST\", \"message\": \"...\", \"details\": {...}}}`.\n\n**Rate limits.** Each key has a per-minute limit (100 by default). Every response carries\n`X-RateLimit-Limit`, `X-RateLimit-Remaining` and `X-RateLimit-Reset`.\n\n**Versioning.** `/v1` never receives breaking changes. New optional fields may be added to responses.\n",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.YOUR_DOMAIN",
      "description": "Public API"
    }
  ],
  "paths": {
    "/v1/geocode": {
      "get": {
        "tags": [
          "Geocoding"
        ],
        "summary": "Geocode a place name or address",
        "description": "Turns a place name or address into coordinates. Results are ranked: exact name matches first, then names that start with the query, then names containing every word of the query. An empty `results` array means nothing matched; it is not an error.",
        "operationId": "geocode",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "Place name or address to search for. Latin and Cyrillic are both supported.",
              "examples": [
                "Sukhbaatar Square"
              ],
              "title": "Q"
            },
            "description": "Place name or address to search for. Latin and Cyrillic are both supported."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "description": "Maximum number of results.",
              "default": 5,
              "title": "Limit"
            },
            "description": "Maximum number of results."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeResponse"
                }
              }
            }
          },
          "400": {
            "description": "400 INVALID_REQUEST",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "Invalid value for 'lat': must be between -90 and 90.",
                    "details": {
                      "field": "lat"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "401 INVALID_API_KEY",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_API_KEY",
                    "message": "The API key is missing or invalid."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "403 API_KEY_REVOKED or ENDPOINT_NOT_ALLOWED",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "API_KEY_REVOKED",
                    "message": "This API key has been revoked."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "408 REQUEST_TIMEOUT",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "REQUEST_TIMEOUT",
                    "message": "The data service did not respond in time."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "429 RATE_LIMIT_EXCEEDED",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "RATE_LIMIT_EXCEEDED",
                    "message": "Too many requests."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "500 INTERNAL_ERROR",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Internal server error."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "502 UPSTREAM_ERROR",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UPSTREAM_ERROR",
                    "message": "The upstream data service returned an error."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "503 SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "The service is temporarily unavailable."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reverse-geocode": {
      "get": {
        "tags": [
          "Reverse geocoding"
        ],
        "summary": "Find the address at a coordinate",
        "description": "Turns a latitude/longitude into the nearest meaningful location: an address if one is close, otherwise a named place, otherwise the nearest named street (`match_type` tells you which). Returns 404 when nothing is found within 2 km.",
        "operationId": "reverseGeocode",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Latitude in decimal degrees (WGS84).",
              "examples": [
                47.9184
              ],
              "title": "Lat"
            },
            "description": "Latitude in decimal degrees (WGS84)."
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Longitude in decimal degrees (WGS84).",
              "examples": [
                106.9177
              ],
              "title": "Lon"
            },
            "description": "Longitude in decimal degrees (WGS84)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReverseGeocodeResponse"
                }
              }
            }
          },
          "400": {
            "description": "400 INVALID_REQUEST",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "Invalid value for 'lat': must be between -90 and 90.",
                    "details": {
                      "field": "lat"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "401 INVALID_API_KEY",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_API_KEY",
                    "message": "The API key is missing or invalid."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "403 API_KEY_REVOKED or ENDPOINT_NOT_ALLOWED",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "API_KEY_REVOKED",
                    "message": "This API key has been revoked."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "404 NOT_FOUND",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "No result was found for this request."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "408 REQUEST_TIMEOUT",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "REQUEST_TIMEOUT",
                    "message": "The data service did not respond in time."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "429 RATE_LIMIT_EXCEEDED",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "RATE_LIMIT_EXCEEDED",
                    "message": "Too many requests."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "500 INTERNAL_ERROR",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Internal server error."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "502 UPSTREAM_ERROR",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UPSTREAM_ERROR",
                    "message": "The upstream data service returned an error."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "503 SERVICE_UNAVAILABLE",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "The service is temporarily unavailable."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/route": {
      "get": {
        "tags": [
          "Routing"
        ],
        "summary": "Calculate a route between two points",
        "description": "Returns the fastest route for the chosen travel mode, with its distance, estimated travel time and a GeoJSON LineString. Origin and destination are snapped to the nearest road the mode can use; the snapped points are returned in `waypoints`.",
        "operationId": "route",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "description": "Longitude and latitude separated by a comma, in that order (GeoJSON order).",
              "examples": [
                "106.9177,47.9184"
              ],
              "title": "Origin"
            },
            "description": "Longitude and latitude separated by a comma, in that order (GeoJSON order)."
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "description": "Longitude and latitude separated by a comma, in that order (GeoJSON order).",
              "examples": [
                "106.9057,47.9220"
              ],
              "title": "Destination"
            },
            "description": "Longitude and latitude separated by a comma, in that order (GeoJSON order)."
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TravelMode",
              "description": "Travel mode.",
              "default": "driving"
            },
            "description": "Travel mode."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "400": {
            "description": "400 INVALID_REQUEST",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "Invalid value for 'lat': must be between -90 and 90.",
                    "details": {
                      "field": "lat"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "401 INVALID_API_KEY",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_API_KEY",
                    "message": "The API key is missing or invalid."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "403 API_KEY_REVOKED or ENDPOINT_NOT_ALLOWED",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "API_KEY_REVOKED",
                    "message": "This API key has been revoked."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "404 NOT_FOUND",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "No result was found for this request."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "408 REQUEST_TIMEOUT",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "REQUEST_TIMEOUT",
                    "message": "The data service did not respond in time."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "429 RATE_LIMIT_EXCEEDED",
            "content": {
