    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "A required dependency is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "properties": {
          "formatted": {
            "type": "string",
            "title": "Formatted",
            "examples": [
              "Sukhbaatar Square, Ulaanbaatar, Mongolia"
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Building, place or street name."
          },
          "house_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "House Number"
          },
          "street": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Street"
          },
          "neighborhood": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Neighborhood",
            "description": "Sub-district, for example a khoroo (хороо)."
          },
          "district": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          }
        },
        "type": "object",
        "required": [
          "formatted"
        ],
        "title": "Address"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_API_KEY",
              "API_KEY_REVOKED",
              "ENDPOINT_NOT_ALLOWED",
              "NOT_FOUND",
              "REQUEST_TIMEOUT",
              "RATE_LIMIT_EXCEEDED",
              "INTERNAL_ERROR",
              "UPSTREAM_ERROR",
              "SERVICE_UNAVAILABLE"
            ],
            "title": "Code",
            "description": "Stable, machine-readable error code."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable explanation. Wording may change; do not parse it."
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details",
            "description": "Optional structured context, for example the offending `field`."
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Identifies this request in the server logs (same as the `X-Request-ID` header). Quote it when you contact support."
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "GeocodeResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "examples": [
              "Sukhbaatar Square"
            ]
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/GeocodeResult"
            },
            "type": "array",
            "title": "Results"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Number of results returned.",
            "examples": [
              1
            ]
          }
        },
        "type": "object",
        "required": [
          "query",
          "results",
          "count"
        ],
        "title": "GeocodeResponse"
      },
      "GeocodeResult": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Opaque, stable identifier of the place.",
            "examples": [
              "plc_123"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Sukhbaatar Square"
            ]
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address",
            "examples": [
              "Ulaanbaatar, Mongolia"
            ]
          },
          "latitude": {
            "type": "number",
            "title": "Latitude",
            "examples": [
              47.9184
            ]
          },
          "longitude": {
            "type": "number",
            "title": "Longitude",
            "examples": [
              106.9177
            ]
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Place category, for example `landmark` or `district`.",
            "examples": [
              "place"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "latitude",
          "longitude",
          "type"
        ],
        "title": "GeocodeResult"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LineString": {
        "properties": {
          "type": {
            "type": "string",
            "const": "LineString",
            "title": "Type",
            "default": "LineString"
          },
          "coordinates": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Coordinates",
            "description": "GeoJSON positions as `[longitude, latitude]` pairs.",
            "examples": [
              [
                [
                  106.9177,
                  47.9184
                ],
                [
                  106.9057,
                  47.922
                ]
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "LineString"
      },
      "Location": {
        "properties": {
          "latitude": {
            "type": "number",
            "title": "Latitude",
            "examples": [
              47.9184
            ]
          },
          "longitude": {
            "type": "number",
            "title": "Longitude",
            "examples": [
              106.9177
            ]
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Location"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "fail",
                "not_configured"
              ]
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "ReverseGeocodeResponse": {
        "properties": {
          "location": {
            "$ref": "#/components/schemas/Location",
            "description": "The coordinates that were requested."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "match_type": {
            "type": "string",
            "enum": [
              "address",
              "place",
              "street"
            ],
            "title": "Match Type",
            "description": "What kind of feature the address was derived from."
          },
          "distance_meters": {
            "type": "number",
            "title": "Distance Meters",
            "description": "Distance from the requested point to the match.",
            "examples": [
              12.4
            ]
          }
        },
        "type": "object",
        "required": [
          "location",
          "address",
          "match_type",
          "distance_meters"
        ],
        "title": "ReverseGeocodeResponse"
      },
      "Route": {
        "properties": {
          "distance_meters": {
            "type": "number",
            "title": "Distance Meters",
            "examples": [
              4200.0
            ]
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds",
            "examples": [
              620.0
            ]
          },
          "geometry": {
            "$ref": "#/components/schemas/LineString"
          }
        },
        "type": "object",
        "required": [
          "distance_meters",
          "duration_seconds",
          "geometry"
        ],
        "title": "Route"
      },
      "RouteResponse": {
        "properties": {
          "route": {
            "$ref": "#/components/schemas/Route"
          },
          "mode": {
            "$ref": "#/components/schemas/TravelMode"
          },
          "waypoints": {
            "items": {
              "$ref": "#/components/schemas/Waypoint"
            },
            "type": "array",
            "title": "Waypoints",
            "description": "Snapped origin and destination, in that order."
          }
        },
        "type": "object",
        "required": [
          "route",
          "mode",
          "waypoints"
        ],
        "title": "RouteResponse"
      },
      "TravelMode": {
        "type": "string",
        "enum": [
          "driving",
          "walking"
        ],
        "title": "TravelMode"
      },
      "Waypoint": {
        "properties": {
          "input": {
            "$ref": "#/components/schemas/Location",
            "description": "The coordinate you sent."
          },
          "location": {
            "$ref": "#/components/schemas/Location",
            "description": "The point on the road network the route starts or ends at."
          },
          "snap_distance_meters": {
            "type": "number",
            "title": "Snap Distance Meters",
            "description": "Distance between `input` and `location`."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Name of the road at the snapped location."
          }
        },
        "type": "object",
        "required": [
          "input",
          "location",
          "snap_distance_meters"
        ],
        "title": "Waypoint"
      }
