# Local development of the API gateway (`uv run uvicorn app.asgi:app --reload`).
# Copy to apps/api/.env. See the root .env.example for every option.
ENVIRONMENT=development
CONVEX_SITE_URL=http://127.0.0.1:3211
GATEWAY_SECRET=dev-only-gateway-secret-change-me-0123456789
API_KEY_PEPPER=dev-only-api-key-pepper-change-me-0123456789
SITE_API_KEY=geo_live_DevOnlySiteKey000000000000000000
CORS_ORIGINS=*
ARCGIS_GEOCODING_FEATURE_SERVER=
ARCGIS_REVERSE_GEOCODING_FEATURE_SERVER=
ARCGIS_ROUTING_FEATURE_SERVER=
