# Local development of the website (`npm run dev`). Copy to apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.arcgis.com/arcgis/rest/services/World_Basemap_v2/VectorTileServer/resources/styles/root.json
# Server-side only:
API_INTERNAL_URL=http://localhost:8000
CONVEX_URL=http://127.0.0.1:3210
# DEVELOPMENT ONLY default; must match SITE_API_KEY used by the API and Convex.
SITE_API_KEY=geo_live_DevOnlySiteKey000000000000000000
