# Public API (FastAPI) without containers, for hosts that run it from a
# virtualenv. Prefer the Podman Quadlet units in ../quadlet on RHEL.
#
# Layout: code in /opt/geo-platform/api (root-owned, read-only for the
# service), virtualenv in /opt/geo-platform/api/.venv, settings in
# /etc/geo-platform/api.env (root:geo-api, 0640). Secrets come from systemd
# credentials (LoadCredentialEncrypted=, see docs/security/linux-hardening.md).

[Unit]
Description=Geo Platform public API
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=geo-api
Group=geo-api
WorkingDirectory=/opt/geo-platform/api
EnvironmentFile=/etc/geo-platform/api.env
Environment=ENVIRONMENT=production PYTHONDONTWRITEBYTECODE=1 CLIENT_IP_HEADER=x-real-ip
# Encrypted with `systemd-creds encrypt`; readable only by this service under
# $CREDENTIALS_DIRECTORY. The start script exports them as variables.
LoadCredentialEncrypted=api_key_pepper:/etc/geo-platform/credentials/api_key_pepper.cred
LoadCredentialEncrypted=gateway_secret:/etc/geo-platform/credentials/gateway_secret.cred
LoadCredentialEncrypted=site_api_key:/etc/geo-platform/credentials/site_api_key.cred
ExecStart=/bin/sh -c 'API_KEY_PEPPER="$(cat "$CREDENTIALS_DIRECTORY/api_key_pepper")" GATEWAY_SECRET="$(cat "$CREDENTIALS_DIRECTORY/gateway_secret")" SITE_API_KEY="$(cat "$CREDENTIALS_DIRECTORY/site_api_key")" exec /opt/geo-platform/api/.venv/bin/uvicorn app.asgi:app --host 127.0.0.1 --port 8009 --no-access-log --no-server-header --timeout-graceful-shutdown 20'
Restart=on-failure
RestartSec=5s

# --- Sandboxing (verify with: systemd-analyze security geo-api.service) ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
# Resource limits.
MemoryMax=512M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
