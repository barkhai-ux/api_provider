# Website (Next.js standalone server) without containers. Prefer the Podman
# Quadlet units in ../quadlet on RHEL.
#
# Layout: the contents of .next/standalone in /opt/geo-platform/web
# (root-owned), with .next/static and public copied next to apps/web/server.js.
# Settings in /etc/geo-platform/web.env (root:geo-web, 0640).

[Unit]
Description=Geo Platform website
Wants=network-online.target
After=network-online.target geo-api.service

[Service]
Type=exec
User=geo-web
Group=geo-web
WorkingDirectory=/opt/geo-platform/web
EnvironmentFile=/etc/geo-platform/web.env
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=8008 CLIENT_IP_HEADER=x-real-ip
LoadCredentialEncrypted=site_api_key:/etc/geo-platform/credentials/site_api_key.cred
ExecStart=/bin/sh -c 'SITE_API_KEY="$(cat "$CREDENTIALS_DIRECTORY/site_api_key")" exec /usr/bin/node apps/web/server.js'
Restart=on-failure
RestartSec=5s
# Next.js writes its runtime cache under .next/cache.
CacheDirectory=geo-web
BindPaths=/var/cache/geo-web:/opt/geo-platform/web/apps/web/.next/cache

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Not MemoryDenyWriteExecute: V8's JIT needs writable+executable memory.
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
MemoryMax=768M
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
