# /etc/audit/rules.d/60-geo-platform.rules — load with `augenrules --load`.
# Changes to the platform's secrets and configuration.
-w /etc/geo-platform/ -p wa -k geo_config
-w /etc/nginx/ -p wa -k geo_nginx
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config
# Privilege use and account changes.
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=unset -k root_commands
