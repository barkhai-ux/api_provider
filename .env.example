# Geo Platform — environment variables
#
# Copy to .env and adjust. docker-compose.yml reads this file; every secret has a
# DEVELOPMENT-ONLY default there so `docker compose up` works without it.
# Never commit a real .env. Generate secrets with: openssl rand -hex 32

# --------------------------------------------------------------------------
# General
# --------------------------------------------------------------------------
# development | test | production. The API treats a missing value as production
# and then refuses to start with development defaults or weak secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Frontend (Next.js). NEXT_PUBLIC_* are inlined at build time (Docker build args).
# --------------------------------------------------------------------------
# Public API origin (shown in docs, called by the API playground).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Convex deployment URL as seen from browsers (developer console live queries).
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# Basemap style. Default: Esri World Street Map (ArcGIS vector tiles; no key).
# ArcGIS VectorTileServer styles (…/VectorTileServer/resources/styles/*.json)
# are rewritten for MapLibre automatically; any other MapLibre style URL works
# as is (for example the ArcGIS Basemap Styles service with ?token=YOUR_KEY).
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.arcgis.com/arcgis/rest/services/World_Basemap_v2/VectorTileServer/resources/styles/root.json
# Website origin (password reset flows, Convex Auth SITE_URL).
WEB_BASE_URL=http://localhost:3000
# Extra origins allowed in the website's Content-Security-Policy connect-src
# (space separated), e.g. tile hosts of a custom map style.
CSP_EXTRA_CONNECT_SRC=

# Server-side only (read at runtime by the Next.js server; never sent to browsers):
#   API_INTERNAL_URL  the API as reachable from the web server (compose: http://api:8000)
#   CONVEX_URL        Convex as reachable from the web server (compose: http://convex-backend:3210)
#   CLIENT_IP_HEADER  optional: a single-IP header set by your edge proxy that overwrites
#                     client values (cf-connecting-ip on Render, x-real-ip behind deploy/nginx).
#   TRUSTED_PROXY_HOPS optional alternative: the number of trusted proxies that append to
#                     X-Forwarded-For. With neither, forwarding headers are ignored.
#   AUTH_RATE_LIMIT_PER_10_MINUTES  sign-in/sign-up/reset requests per visitor (default 60;
#                     only applied when the visitor address is known).

# --------------------------------------------------------------------------
# Shared secrets (must be identical for every service that uses them)
# --------------------------------------------------------------------------
# HMAC pepper for API key hashing (API gateway + Convex).
API_KEY_PEPPER=change-me
# Shared secret between the API gateway and Convex's /gateway HTTP actions.
GATEWAY_SECRET=change-me
# The website's own API key, used only server-side by the map proxy.
# Format: geo_ + 32 letters/digits (generate one with: node scripts/generate-secrets.mjs).
# Registered in Convex on deploy.
# The value below is a DEVELOPMENT-ONLY default; the API refuses it in production.
SITE_API_KEY=geo_live_DevOnlySiteKey000000000000000000
# Note: the spec's JWT_SECRET is not used. Convex Auth signs sessions with an
# RS256 key pair (JWT_PRIVATE_KEY / JWKS) that the deploy job generates once
# and stores in the Convex deployment.

# --------------------------------------------------------------------------
# Convex (stores accounts, API keys, usage, rate limits)
# --------------------------------------------------------------------------
# Option A (default): self-hosted backend in docker compose, settings below.
# Option B: Convex Cloud. Set these five and leave the self-hosted ones as is:
#   CONVEX_DEPLOY_KEY=<Dashboard > Settings > Deploy keys>
#   NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud   (Cloud URL)
#   CONVEX_URL=https://<deployment>.convex.cloud               (web server)
#   CONVEX_SITE_URL=https://<deployment>.convex.site           (HTTP Actions URL, API gateway)
#   plus strong API_KEY_PEPPER / GATEWAY_SECRET / SITE_API_KEY and
#   SEED_DEMO_ACCOUNT=false: the deployment is on the public internet, so
#   development defaults are unsafe.
CONVEX_DEPLOY_KEY=
CONVEX_INSTANCE_NAME=geo-platform
# 64 hex characters (openssl rand -hex 32). DEVELOPMENT-ONLY value below.
# Changing it invalidates admin keys, not data.
CONVEX_INSTANCE_SECRET=6465762d6f6e6c792d636f6e7665782d696e7374616e63652d73656372657421
# Origins browsers use to reach Convex (put behind TLS in production).
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
# Days to keep raw per-request usage rows (daily totals are kept).
USAGE_RETENTION_DAYS=30

# Password reset emails: console (development only; codes appear in Convex logs)
# or resend (https://resend.com).
EMAIL_BACKEND=console
EMAIL_FROM=Geo Platform <no-reply@example.com>
RESEND_API_KEY=

# DEVELOPMENT ONLY demo account, seeded when SEED_DEMO_ACCOUNT=true and
# ENVIRONMENT is not production. Keep false on internet-reachable deployments.
SEED_DEMO_ACCOUNT=true
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-password-dev-only
DEMO_API_KEY=geo_test_DevOnlyDemoKey000000000000000000

# --------------------------------------------------------------------------
# API gateway (FastAPI)
# --------------------------------------------------------------------------
PUBLIC_API_URL=http://localhost:8000
# Browser origins allowed to call /v1 directly (comma separated). Production
# requires explicit https origins; "*" is refused there.
CORS_ORIGINS=http://localhost:3000
# Per key and per minute (a key can have its own value in Convex).
RATE_LIMIT_PER_MINUTE=100
# Per-visitor limit for requests made with SITE_API_KEY (the public map).
SITE_KEY_PER_IP_PER_MINUTE=60
# Set in Convex (npx convex env set): the ceiling for all keys of one account,
# and a separate, lower limit for /v1/route.
# ACCOUNT_RATE_LIMIT_PER_MINUTE=300
# ROUTE_RATE_LIMIT_PER_MINUTE=30
# Failed key checks per client IP and minute before 429 (checked before Convex).
FAILED_AUTH_PER_IP_PER_MINUTE=60
# A single-IP header set by a trusted edge proxy (cf-connecting-ip on Render).
# Leave empty when clients connect directly or through a local reverse proxy.
CLIENT_IP_HEADER=
# Request shape limits (checked before anything else).
MAX_QUERY_STRING_BYTES=2048
MAX_QUERY_PARAMS=16
MAX_HEADER_BYTES=16384
# Swagger UI / ReDoc: default on outside production, off in production.
# API_DOCS_ENABLED=false
# ArcGIS upstream budget: concurrent calls, queue wait, response size cap.
ARCGIS_MAX_CONCURRENCY=16
ARCGIS_QUEUE_TIMEOUT_SECONDS=5
ARCGIS_MAX_RESPONSE_BYTES=33554432
# Production only accepts https upstreams on public addresses; set true only
# for services on a private network you control (e.g. self-hosted Convex).
ALLOW_HTTP_UPSTREAMS=false
# In-process geocoding cache in seconds; 0 disables it.
CACHE_GEOCODE_TTL_SECONDS=0

# --------------------------------------------------------------------------
# ArcGIS FeatureServer (internal data source; never exposed publicly)
# --------------------------------------------------------------------------
# GeocodeServer (locator), e.g.
#   https://arcgis.example.mn/arcgis/rest/services/locator/POI/GeocodeServer
# When set, it answers /v1/geocode (suggest + findAddressCandidates) and
# /v1/reverse-geocode (reverseGeocode); the layers below become fallbacks.
ARCGIS_GEOCODE_SERVER=
# Layer URLs (.../FeatureServer/<layerId>). A service URL (.../FeatureServer)
# means layer 0. Leave empty until available: the endpoint then answers 503.
ARCGIS_GEOCODING_FEATURE_SERVER=https://arcgis.ubhub.mn/arcgis/rest/services/locator/MN_OrtsGarts_POI/GeocodeServer
ARCGIS_REVERSE_GEOCODING_FEATURE_SERVER=
ARCGIS_ROUTING_FEATURE_SERVER=
# Network Analyst route layer (.../NAServer/Route). When set, it answers
# /v1/route (ROUTING_PROVIDER=auto) instead of the road layer below.
ARCGIS_ROUTE_SERVICE=
# Travel-mode names on the route service; empty = pick by type (AUTOMOBILE /
# WALK), preferring time-based modes.
ROUTING_NA_DRIVING_TRAVEL_MODE=
ROUTING_NA_WALKING_TRAVEL_MODE=

# Authentication for secured services (e.g. ArcGIS Enterprise), in order of
# precedence. Generated tokens are renewed automatically.
# 1. An OAuth app (client_credentials grant via <server>/arcgis/sharing/rest/oauth2/token).
#    Its tokens may only validate with the app's registered redirect URI sent as
#    Referer: set ARCGIS_TOKEN_REFERER to it.
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=
# 2. A service account (tokens via generateToken)...
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# ...defaults to <server>/arcgis/sharing/rest/generateToken:
ARCGIS_TOKEN_URL=
ARCGIS_TOKEN_EXPIRATION_MINUTES=60
# Bind tokens to this Referer (sent with every request) instead of our IP.
ARCGIS_TOKEN_REFERER=
# ...or a static token (sent as X-Esri-Authorization: Bearer <token>).
ARCGIS_TOKEN=
ARCGIS_TIMEOUT_SECONDS=8
ARCGIS_MAX_RETRIES=2

# Field mapping: places layer (forward geocoding; also used by reverse fallback).
ARCGIS_PLACES_NAME_FIELD=name
ARCGIS_PLACES_ALT_NAME_FIELD=alt_name
ARCGIS_PLACES_ADDRESS_FIELD=address
ARCGIS_PLACES_TYPE_FIELD=type
ARCGIS_PLACES_IMPORTANCE_FIELD=importance

# Field mapping: addresses layer (reverse geocoding). Empty = not present.
ARCGIS_ADDRESSES_FORMATTED_FIELD=address
ARCGIS_ADDRESSES_NAME_FIELD=name
ARCGIS_ADDRESSES_STREET_FIELD=street
ARCGIS_ADDRESSES_HOUSE_NUMBER_FIELD=house_number
ARCGIS_ADDRESSES_DISTRICT_FIELD=district
ARCGIS_ADDRESSES_CITY_FIELD=city
ARCGIS_ADDRESSES_COUNTRY_FIELD=country
ADDRESS_DEFAULT_CITY=Ulaanbaatar
ADDRESS_DEFAULT_COUNTRY=Mongolia
REVERSE_GEOCODE_RADII_METERS=100,500,2000

# Field mapping: roads layer (routing).
ARCGIS_ROADS_NAME_FIELD=name
ARCGIS_ROADS_CLASS_FIELD=road_class
ARCGIS_ROADS_ONEWAY_FIELD=oneway
ARCGIS_ROADS_SPEED_FIELD=speed_kmh
# Values meaning one-way along / against the digitized direction.
ARCGIS_ONEWAY_FORWARD_VALUES=FT,yes,true,1,Y,T
ARCGIS_ONEWAY_REVERSE_VALUES=TF,-1,reverse

# Routing limits and profiles.
ROUTING_MAX_FEATURES=250000
ROUTING_MAX_DISTANCE_KM=100
ROUTING_MAX_SNAP_METERS=500
ROUTING_GRAPH_TTL_SECONDS=3600
ROUTING_DRIVING_DEFAULT_SPEED_KMH=30
ROUTING_DRIVING_MAX_SPEED_KMH=110
ROUTING_WALKING_SPEED_KMH=5
# JSON object road_class -> km/h (overrides the built-in table when set).
# ROUTING_DRIVING_SPEEDS_KMH={"primary":60,"secondary":50,"residential":25}
ROUTING_DRIVING_EXCLUDED_CLASSES=footway,path,pedestrian,steps,cycleway,bridleway,corridor
ROUTING_WALKING_EXCLUDED_CLASSES=motorway,motorway_link,trunk,trunk_link
